#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/common.sh"

case ${1:-} in
    -h | --help)
        show_usage "scripts/check" "Preview stow changes and report missing local-only files."
        exit 0
        ;;
esac

require_stow
packages=$(resolve_packages "$@")
# intentional word splitting for package membership checks
# shellcheck disable=SC2086
set -- $packages

target_gitconfig_local=$TARGET_DIR/.gitconfig.local
target_zprofile_local=$TARGET_DIR/.zprofile.local
target_zshrc_local=$TARGET_DIR/.zshrc.local
status=0

print_context "check" "$packages"

section "local files"

if has_package git "$@" && [ -f "$target_gitconfig_local" ]; then
    status_line ok "$target_gitconfig_local"
elif has_package git "$@"; then
    status_line note "missing required local file: $target_gitconfig_local"
    status=1
fi

if has_package zsh "$@" && [ -f "$target_zprofile_local" ]; then
    status_line ok "$target_zprofile_local"
elif has_package zsh "$@"; then
    status_line note "optional local file not found: $target_zprofile_local"
fi

if has_package zsh "$@" && [ -f "$target_zshrc_local" ]; then
    status_line ok "$target_zshrc_local"
elif has_package zsh "$@"; then
    status_line note "optional local file not found: $target_zshrc_local"
fi

cd "$DOTFILES_DIR"

section "stow dry-run"
tmp_output=$(mktemp "${TMPDIR:-/tmp}/dotfiles-stow-check.XXXXXX")
trap 'rm -f "$tmp_output"' EXIT HUP INT TERM

# shellcheck disable=SC2086
if stow -nv --target="$TARGET_DIR" $packages >"$tmp_output" 2>&1; then
    :
else
    status=1
fi

cat "$tmp_output"

if ! grep -Ev '^(WARNING: in simulation mode so not modifying filesystem\.|)$' "$tmp_output" >/dev/null 2>&1; then
    status_line ok "no symlink changes required"
fi

rm -f "$tmp_output"
trap - EXIT HUP INT TERM
exit "$status"
