#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/common.sh"

require_stow
packages=$(resolve_packages "$@")
# intentional word splitting for package membership checks
# shellcheck disable=SC2086
set -- $packages

printf 'repo: %s\n' "$DOTFILES_DIR"
printf 'target: %s\n' "$TARGET_DIR"
printf 'packages: %s\n' "$packages"

target_gitconfig_local=$TARGET_DIR/.gitconfig.local
target_zprofile_local=$TARGET_DIR/.zprofile.local
target_zshrc_local=$TARGET_DIR/.zshrc.local

if has_package git "$@" && [ ! -f "$target_gitconfig_local" ]; then
    printf 'note: missing %s\n' "$target_gitconfig_local"
fi

if has_package zsh "$@" && [ ! -f "$target_zprofile_local" ]; then
    printf 'note: optional %s not found\n' "$target_zprofile_local"
fi

if has_package zsh "$@" && [ ! -f "$target_zshrc_local" ]; then
    printf 'note: optional %s not found\n' "$target_zshrc_local"
fi

cd "$DOTFILES_DIR"

status=0
# shellcheck disable=SC2086
stow -nv --target="$TARGET_DIR" $packages || status=$?
exit "$status"
